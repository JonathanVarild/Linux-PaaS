{
	"name": "linux-paas",
	"version": "0.0.0",
	"description": "",
	"private": true,
	"scripts": {
		"start": "tsx src/app.ts",
		"dev": "tsx watch src/app.ts",
		"install:daemon": "sh ./scripts/install-debian-service.sh",
		"install:paas": "sh ./scripts/install-paas-command.sh",
		"install:ufw": "sh ./scripts/install-ufw-rules.sh",
		"create": "tsx src/cli.ts create",
		"config": "tsx src/cli.ts config",
		"accept": "tsx src/cli.ts accept",
		"join": "tsx src/cli.ts join",
		"kick": "tsx src/cli.ts kick",
		"remove": "tsx src/cli.ts remove",
		"deploy": "tsx src/cli.ts deploy",
		"status": "tsx src/cli.ts status",
		"reelect": "tsx src/cli.ts reelect",
		"redeploy": "docker compose down -v && docker compose up -d --build",
		"shell1": "docker compose exec worker-1 /bin/bash",
		"shell2": "docker compose exec worker-2 /bin/bash",
		"shell3": "docker compose exec worker-3 /bin/bash"
	},
	"dependencies": {
		"@types/node-ipc": "^9.2.3",
		"commander": "^14.0.1",
		"express": "^5.1.0",
		"node-fetch": "^3.3.2",
		"node-ipc": "^12.0.0",
		"tsx": "^4.20.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.2"
	}
}
